# systemd unit for the Bob OOB sink reference daemon (PR6).
# Install: copy to /etc/systemd/system/, edit the env, then
#   systemctl daemon-reload && systemctl enable --now bob-oob-sink
#
# Runs as a dedicated unprivileged user with only CAP_NET_BIND_SERVICE so it can
# bind :53 / :80 without root. Adjust paths + env for your deployment.

[Unit]
Description=Hacker Bob OOB sink (DNS + HTTP callback + token-scoped poll API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bob-oob
Group=bob-oob
WorkingDirectory=/opt/bob-oob-sink
ExecStart=/usr/bin/node /opt/bob-oob-sink/oob-sink.js
Restart=on-failure
RestartSec=3

# --- provisioning env (edit these) ---
Environment=OOB_ZONE=oob.example.com
Environment=OOB_ANSWER_IP=203.0.113.10
Environment=OOB_POLL_PORT=8443
Environment=OOB_POLL_TLS_CERT=/etc/letsencrypt/live/poll.oob.example.com/fullchain.pem
Environment=OOB_POLL_TLS_KEY=/etc/letsencrypt/live/poll.oob.example.com/privkey.pem
# Environment=OOB_TTL_MS=172800000

# --- hardening ---
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/
# Let's Encrypt certs are read-only; no writable paths required (state is in-memory).

[Install]
WantedBy=multi-user.target
