# Dockerfile.runner-ec2 — the Release A runner image.
#
# Bob engine (unmodified mcp/ tree) + DeepSeek Harness (pinned) + the EC2
# entrypoint. The dsh composition mounts ONLY the Bob MCP server as the model's
# tool surface: no dsh-native bash/fs/subprocess tools, so every offensive
# action stays behind Bob's scope/egress kernel. No AgentCore SDK, no Claude
# CLI, no Bedrock settings — this image is the EC2 path only.

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates jq \
  && rm -rf /var/lib/apt/lists/*

# --- pinned DeepSeek Harness (developer preview: pin exact, bump deliberately) ---
RUN npm install -g @deepseek-ai/dsh@0.1.1-rc.2

# --- hacker-bob engine (UNMODIFIED) ---
WORKDIR /opt/hacker-bob
COPY mcp/ ./mcp/
COPY scripts/ ./scripts/
COPY adapters/ ./adapters/
COPY package.json package-lock.json ./
COPY packages/bob-diff-review/package.json ./packages/bob-diff-review/package.json
RUN npm ci --omit=dev --omit=optional
# Convex client for the entrypoint (runs.setStatus/appendEvent, reports.publish).
RUN npm install --save-exact convex@1.44.0

# --- runner files ---
COPY infra/runner/dsh/cordis.yml /opt/bob-runner/cordis.yml
COPY infra/runner/entrypoint.js /opt/bob-runner/entrypoint.js

ENV HOME=/workspace
ENV BOB_SESSIONS_ROOT=/workspace/hacker-bob-sessions
ENV DEEPSEEK_BASE_URL=
WORKDIR /opt/bob-runner

ENTRYPOINT ["node", "/opt/bob-runner/entrypoint.js"]
